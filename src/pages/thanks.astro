---
import Base from '../layouts/Base.astro';
---

<Base title="Thank You — CC3PO Shield" description="Thank you for subscribing to CC3PO Shield. Carlos will reach out within 24 hours to set up your account and schedule your free compliance scan.">

  <!-- Nav (matches index.astro) -->
  <nav style="border-bottom:1px solid var(--border);backdrop-filter:blur(12px);background:rgba(10,10,10,0.8);position:sticky;top:0;z-index:50;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;height:64px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span style="font-weight:700;font-size:1.2rem;">Shield</span>
        <span style="color:var(--text-dim);font-size:0.85rem;margin-left:4px;">by CC3PO</span>
      </div>
      <a href="tel:+120****1265" class="btn btn-primary" style="padding:8px 20px;font-size:0.85rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call Now
      </a>
    </div>
  </nav>

  <section style="padding:120px 0 80px;text-align:center;">
    <div class="container" style="max-width:680px;">
      <div style="margin:0 auto 32px;width:88px;height:88px;border-radius:50%;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1 style="font-size:2.75rem;font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">
        You're Protected.
      </h1>
      <p style="font-size:1.2rem;color:var(--text-muted);max-width:560px;margin:0 auto 40px;">
        Thanks for subscribing to CC3PO Shield. Your card was charged and your subscription is active.
      </p>

      <!-- Next steps -->
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;text-align:left;margin-bottom:32px;">
        <h2 style="font-size:1.2rem;font-weight:700;margin-bottom:20px;">What happens next</h2>
        <ol style="list-style:none;display:flex;flex-direction:column;gap:16px;">
          <li style="display:flex;gap:14px;align-items:start;">
            <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:rgba(59,130,246,0.1);color:var(--accent);font-weight:700;font-size:0.85rem;">1</span>
            <div>
              <strong style="color:var(--text);display:block;margin-bottom:2px;">Carlos emails you within 24 hours</strong>
              <span style="color:var(--text-muted);font-size:0.9rem;">He'll confirm activation, gather your site details, and schedule your onboarding call.</span>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:start;">
            <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:rgba(59,130,246,0.1);color:var(--accent);font-weight:700;font-size:0.85rem;">2</span>
            <div>
              <strong style="color:var(--text);display:block;margin-bottom:2px;">15-minute setup call</strong>
              <span style="color:var(--text-muted);font-size:0.9rem;">We review your site, set up monitoring, and answer questions.</span>
            </div>
          </li>
          <li style="display:flex;gap:14px;align-items:start;">
            <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:rgba(59,130,246,0.1);color:var(--accent);font-weight:700;font-size:0.85rem;">3</span>
            <div>
              <strong style="color:var(--text);display:block;margin-bottom:2px;">Free compliance scan + first weekly report</strong>
              <span style="color:var(--text-muted);font-size:0.9rem;">Delivered to your inbox within 7 days.</span>
            </div>
          </li>
        </ol>
      </div>

      <!-- If they have a demand letter right now -->
      <div style="background:rgba(239,68,68,0.05);border:1px solid rgba(239,68,68,0.2);border-radius:var(--radius);padding:24px;text-align:left;margin-bottom:32px;">
        <h3 style="color:#ef4444;font-weight:700;font-size:1.05rem;margin-bottom:8px;">Got a demand letter right now?</h3>
        <p style="color:var(--text-muted);font-size:0.95rem;margin-bottom:16px;">
          Forward it to <a href="mailto:legal@cc3po.com" style="color:var(--accent);font-weight:600;">legal@cc3po.com</a> right after this — we'll start drafting your response within 24 hours. Same-day for Full Shield subscribers.
        </p>
      </div>

      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:24px;">
        <a href="https://calendly.com/cc3po/30min" class="btn btn-primary" style="font-size:1.05rem;padding:16px 36px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Book Onboarding Call
        </a>
        <a href="tel:+120****1265" class="btn btn-outline">Call (209) 232-1265</a>
      </div>

      <p style="font-size:0.85rem;color:var(--text-dim);margin-top:32px;">
        Need help? Email <a href="mailto:support@cc3po.com" style="color:var(--accent);">support@cc3po.com</a>
        — typically responds within 2 business hours.
      </p>
    </div>
  </section>

  <!-- Footer (matches index.astro) -->
  <footer style="border-top:1px solid var(--border);padding:40px 0;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span style="font-weight:600;">Shield</span>
        <span style="color:var(--text-dim);font-size:0.85rem;">by CC3PO</span>
      </div>
      <div style="display:flex;gap:24px;font-size:0.85rem;">
        <a href="https://cc3po.com" style="color:var(--text-muted);">CC3PO</a>
        <a href="tel:+120****1265" style="color:var(--text-muted);">(209) 232-1265</a>
        <a href="https://cc3po.com/privacy" style="color:var(--text-muted);">Privacy</a>
        <a href="https://cc3po.com/terms" style="color:var(--text-muted);">Terms</a>
      </div>
      <p style="color:var(--text-dim);font-size:0.8rem;">&copy; 2026 CC3PO. All rights reserved.</p>
    </div>
  </footer>

</Base>