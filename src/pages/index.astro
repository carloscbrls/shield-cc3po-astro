---
import Base from '../layouts/Base.astro';
---
<Base title="Shield — Always-On Compliance Monitoring | CC3PO" description="Continuous ADA/WCAG compliance monitoring, automated violation alerts, and weekly reports. Protect your business from compliance lawsuits starting at $97/mo.">

  <!-- Nav -->
  <nav style="border-bottom:1px solid var(--border);backdrop-filter:blur(12px);background:rgba(10,10,10,0.8);position:sticky;top:0;z-index:50;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;height:64px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span style="font-weight:700;font-size:1.2rem;">Shield</span>
        <span style="color:var(--text-dim);font-size:0.85rem;margin-left:4px;">by CC3PO</span>
      </div>
      <div style="display:flex;align-items:center;gap:24px;">
        <a href="#features" style="color:var(--text-muted);font-size:0.9rem;">Features</a>
        <a href="#pricing" style="color:var(--text-muted);font-size:0.9rem;">Pricing</a>
        <a href="#faq" style="color:var(--text-muted);font-size:0.9rem;">FAQ</a>
        <a href="https://cc3po.com/contact" class="btn btn-primary" style="padding:8px 20px;font-size:0.85rem;">Start Free Trial</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section style="padding:100px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(59,130,246,0.12) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 32px;width:80px;height:80px;border-radius:20px;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.2);display:flex;align-items:center;justify-content:center;">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      </div>
      <h1 style="font-size:3.5rem;font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">
        Always-On Compliance.<br/><span style="color:var(--accent);">Never Miss a Violation.</span>
      </h1>
      <p style="font-size:1.25rem;color:var(--text-muted);max-width:600px;margin:0 auto 40px;">
        Shield continuously monitors your website for ADA, WCAG, and compliance violations — alerting you before they become lawsuits.
      </p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://cc3po.com/contact" class="btn btn-primary">Start 14-Day Free Trial</a>
        <a href="#features" class="btn btn-outline">See What's Included</a>
      </div>
      <p style="margin-top:16px;font-size:0.85rem;color:var(--text-dim);">No credit card required &middot; $97/mo after trial</p>
    </div>
  </section>

  <!-- Fear Section -->
  <section style="background:var(--bg-card);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container" style="text-align:center;max-width:720px;">
      <p style="font-size:1.35rem;font-weight:600;line-height:1.5;">
        <span style="color:var(--accent);">1 in 4</span> small businesses faces a compliance lawsuit. The average ADA lawsuit settlement is <span style="color:var(--accent);">$75,000</span>. Shield keeps you off that list.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section id="features">
    <div class="container">
      <div style="text-align:center;margin-bottom:48px;">
        <h2 style="font-size:2rem;font-weight:700;margin-bottom:12px;">What's Included</h2>
        <p style="color:var(--text-muted);font-size:1.05rem;">Everything you need to stay compliant, automatically.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
        <!-- Feature 1 -->
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3 style="font-weight:600;margin-bottom:8px;">ADA/WCAG Continuous Monitoring</h3>
          <p style="color:var(--text-muted);font-size:0.95rem;">24/7 scanning against WCAG 2.1 AA and ADA standards. New violations detected within hours, not months.</p>
        </div>
        <!-- Feature 2 -->
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
          </div>
          <h3 style="font-weight:600;margin-bottom:8px;">Weekly Compliance Reports</h3>
          <p style="color:var(--text-muted);font-size:0.95rem;">Clear, actionable reports delivered to your inbox every week. Track your compliance score over time.</p>
        </div>
        <!-- Feature 3 -->
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3 style="font-weight:600;margin-bottom:8px;">Instant Violation Alerts</h3>
          <p style="color:var(--text-muted);font-size:0.95rem;">Get email alerts the moment a violation is detected. Fix issues before anyone files a complaint.</p>
        </div>
        <!-- Feature 4 -->
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3 style="font-weight:600;margin-bottom:8px;">Security Headers Check</h3>
          <p style="color:var(--text-muted);font-size:0.95rem;">Automated verification of essential security headers — CSP, HSTS, X-Frame-Options, and more.</p>
        </div>
        <!-- Feature 5 -->
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
          </div>
          <h3 style="font-weight:600;margin-bottom:8px;">Compliance Score Dashboard</h3>
          <p style="color:var(--text-muted);font-size:0.95rem;">See your compliance health at a glance. Score breakdowns by category with trend tracking.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" style="background:var(--bg-card);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container" style="text-align:center;">
      <h2 style="font-size:2rem;font-weight:700;margin-bottom:12px;">Simple Pricing</h2>
      <p style="color:var(--text-muted);font-size:1.05rem;margin-bottom:48px;">One plan. Everything included. No surprises.</p>
      <div style="max-width:440px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:16px;padding:48px 40px;">
        <div style="display:inline-block;padding:4px 14px;border-radius:20px;background:rgba(59,130,246,0.1);color:var(--accent);font-size:0.8rem;font-weight:600;margin-bottom:24px;">MOST POPULAR</div>
        <h3 style="font-size:1.5rem;font-weight:700;margin-bottom:8px;">Shield</h3>
        <div style="margin-bottom:8px;">
          <span style="font-size:3.5rem;font-weight:800;">$97</span>
          <span style="color:var(--text-muted);font-size:1.1rem;">/month</span>
        </div>
        <p style="color:var(--text-dim);font-size:0.9rem;margin-bottom:32px;">Billed annually at $994/yr <span style="color:var(--accent);">($83/mo — save $170)</span></p>
        <ul style="text-align:left;list-style:none;margin-bottom:36px;display:flex;flex-direction:column;gap:14px;">
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            ADA/WCAG continuous monitoring
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Weekly compliance reports
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Instant email violation alerts
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Security headers verification
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Compliance score dashboard
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);font-size:0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            14-day free trial
          </li>
        </ul>
        <a href="https://cc3po.com/contact" class="btn btn-primary" style="width:100%;justify-content:center;">Start Free Trial</a>
        <p style="margin-top:14px;font-size:0.8rem;color:var(--text-dim);">No credit card required</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="container" style="max-width:720px;">
      <h2 style="font-size:2rem;font-weight:700;text-align:center;margin-bottom:48px;">Frequently Asked Questions</h2>
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:28px;">
          <h4 style="font-weight:600;margin-bottom:10px;font-size:1.05rem;">What compliance standards does Shield monitor?</h4>
          <p style="color:var(--text-muted);font-size:0.95rem;">Shield monitors against WCAG 2.1 Level AA guidelines and ADA Title III requirements — the standards most commonly cited in accessibility lawsuits targeting businesses.</p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:28px;">
          <h4 style="font-weight:600;margin-bottom:10px;font-size:1.05rem;">How quickly are violations detected?</h4>
          <p style="color:var(--text-muted);font-size:0.95rem;">Shield scans your site continuously. New violations are typically detected within hours and you receive an email alert immediately — so you can fix issues before anyone files a complaint.</p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:28px;">
          <h4 style="font-weight:600;margin-bottom:10px;font-size:1.05rem;">Can Shield prevent a lawsuit?</h4>
          <p style="color:var(--text-muted);font-size:0.95rem;">While no tool can guarantee you'll never face legal action, continuous monitoring and prompt remediation are your strongest defense. Many lawsuits target known, unpatched violations — Shield helps you catch and fix them first.</p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:28px;">
          <h4 style="font-weight:600;margin-bottom:10px;font-size:1.05rem;">What does the 14-day free trial include?</h4>
          <p style="color:var(--text-muted);font-size:0.95rem;">Full access to all Shield features — monitoring, alerts, reports, dashboard, and security checks. No credit card required. After 14 days, choose to continue at $97/mo or cancel with one click.</p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius);padding:28px;">
          <h4 style="font-weight:600;margin-bottom:10px;font-size:1.05rem;">Is Shield only for US businesses?</h4>
          <p style="color:var(--text-muted);font-size:0.95rem;">Shield monitors WCAG standards which are recognized internationally. While our legal context focuses on ADA (US), the technical compliance checks apply to EAA (EU), AODA (Canada), and similar accessibility laws worldwide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="text-align:center;border-top:1px solid var(--border);">
    <div class="container" style="max-width:640px;">
      <h2 style="font-size:2rem;font-weight:700;margin-bottom:16px;">Stop guessing. Start monitoring.</h2>
      <p style="color:var(--text-muted);font-size:1.05rem;margin-bottom:32px;">Join businesses that sleep better knowing Shield is watching their compliance — 24/7.</p>
      <a href="https://cc3po.com/contact" class="btn btn-primary">Start Your 14-Day Free Trial</a>
    </div>
  </section>

  <!-- Footer -->
  <footer style="border-top:1px solid var(--border);padding:40px 0;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span style="font-weight:600;">Shield</span>
        <span style="color:var(--text-dim);font-size:0.85rem;">by CC3PO</span>
      </div>
      <div style="display:flex;gap:24px;font-size:0.85rem;">
        <a href="https://cc3po.com" style="color:var(--text-muted);">CC3PO</a>
        <a href="https://cc3po.com/contact" style="color:var(--text-muted);">Contact</a>
        <a href="https://cc3po.com/privacy" style="color:var(--text-muted);">Privacy</a>
        <a href="https://cc3po.com/terms" style="color:var(--text-muted);">Terms</a>
      </div>
      <p style="color:var(--text-dim);font-size:0.8rem;">&copy; 2026 CC3PO. All rights reserved.</p>
    </div>
  </footer>

</Base>