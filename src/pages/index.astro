    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(239,68,68,0.1) 0%,rgba(59,130,246,0.08) 40%,transparent 70%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
